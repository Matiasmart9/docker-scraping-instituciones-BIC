# ==========================================
# Configuración del Portal Satélite BICSA
# ==========================================

# Entorno: development | production
NODE_ENV=development
ENVIRONMENT=development

# Credenciales para el portal fuente BICSA (https://bicquerywebapp.azurewebsites.net)
BICSA_BASE_URL=https://bicquerywebapp.azurewebsites.net
BICSA_USER=tu_usuario_bicsa
BICSA_PASSWORD=tu_password_bicsa

# Base de datos PostgreSQL
POSTGRES_USER=bicsa_user
POSTGRES_PASSWORD=bicsa_secure_password_2026
POSTGRES_DB=bicsa_satelite_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL de conexión a la BD para SQLAlchemy / Python
DATABASE_URL=postgresql://bicsa_user:bicsa_secure_password_2026@db:5432/bicsa_satelite_db

# Seguridad del Dashboard Satélite
SECRET_KEY=bicsa_super_secret_jwt_key_change_in_production_2026!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_INITIAL_USER=admin@bicsasatelite.com
ADMIN_INITIAL_PASSWORD=AdminPassword2026!

# Horarios de Scraping (Zona Horaria)
TIMEZONE=America/Argentina/Buenos_Aires
FULL_SCRAPE_CRON=0 7 * * *      # Todos los días a las 07:00 hs
LIGHT_SCRAPE_CRON=0 16 * * 1-5  # Lunes a Viernes a las 16:00 hs

# Configuración de URLs internas Docker
BACKEND_URL=http://backend:8000
SCRAPER_URL=http://scraper:8001
